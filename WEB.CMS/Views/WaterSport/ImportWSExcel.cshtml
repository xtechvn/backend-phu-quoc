@using Entities.Models;
@{
    Layout = null;
    var client = (Client)ViewBag.client;
}

<div class="mb10">
    <div class="form-group mb10 mr-2" style="min-width: 200px;">
        <select class="form-group " id="HotelId_ws" multiple style="width:100%!important">
            @if (client != null)
            {
                <option selected value="@client.Id">@client.ClientName - @client.Email - @client.Phone</option>
            }
        </select>
        <div class="red p-3 rounded mb20 mfp-hide" id="HotelId_ws-error" >
           Khách hàng chưa được chọn
        </div>
    </div>

    <label class="btn btn-success" style="margin-right:10px">
        <input class="mfp-hide" type="file" id="import-file-ws">
        Tải tập tin
    </label>
    <span style="color:#ADB0B1">Import file mẫu đơn hàng thể thao biển. Định dạng: xlsx,xls</span>
</div>

<div class="red p-3 rounded mb20 mfp-hide" id="import-ws-error" style="background: #F3DFDF;">
    Lỗi xảy ra: File upload không đúng định dạng, Hệ thống không nhận biết được các cột
</div>

<div class="row">
    <div class="col-md-12" id="grid_ws">

    </div>
</div>

<div class="form-default">
    <div class="form-group align-right mt20 block">
        <button type="button" id="confirm-ws-import" class="btn btn-default bg-main" onclick="water_sport_excel.ConfirmImport()" style="display:none;">
            <i class="fa fa-floppy-o"></i>Cập nhật
        </button>
        <button type="button" class="btn btn-default cancel" data-dismiss="modal" onclick="$.magnificPopup.close()"><i class="fa fa-minus-circle"></i>Đóng</button>
    </div>
</div>

<script type="text/javascript" src="~/modules/water_sport_excel.js"></script>
<script>
    water_sport_excel.HotelSuggestion();
</script>