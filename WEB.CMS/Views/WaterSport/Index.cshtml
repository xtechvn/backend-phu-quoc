@using Entities.Models;
@{
    ViewData["Title"] = "Thể thao biển";
    Entities.ViewModels.HotelESViewModel hotel = (Entities.ViewModels.HotelESViewModel)ViewBag.Hotel;
    var client = (Client)ViewBag.client;

}

<section style="overflow-x: hidden;">
    <div class="row-main container">
        <h2 class="txt_18 bold mb20">Thể thao biển</h2>
        <div class="flex fillter-donhang">
            <div class="form-group mb10 mr-2" style="min-width: 200px;">
                <select class="form-group select2 " id="ClientId" onchange="_water_sport.SearchData()" style="width:100%!important">
                    @if (client != null)
                    {
                        <option selected value="@client.Id">@client.ClientName - @client.Email - @client.Phone</option>
                    }
                </select>
            </div>

            <div class="form-group mb10 mr-2">
                <input type="text" class="form-control" id="UserName" placeholder="Tên Khách" style="width: 150px;">
            </div>
            <div class="form-group mb10 mr-2">
                <input type="text" class="form-control" id="RoomN" placeholder="Số phòng" style="width: 150px;">
            </div>

            <div class="mb10 mr-2">

                <button type="button" class="btn btn-default bg-main" onclick="_water_sport.SearchData()">
                    <svg class="icon-svg" style="vertical-align: sub;">
                        <use xlink:href="/images/icons/icon.svg#search"></use>
                    </svg>
                    Tìm kiếm
                </button>
            </div>
            <div class="form-group mb10 mr-2 text-right" bis_skin_checked="1">
                <button type="submit" class="btn btn-default" style="" onclick="_water_sport.ImportWSExcel()">Import đơn hàng TTB</button>
                <button type="submit" class="btn btn-default" style="" id="Create_Order" onclick="_water_sport.WaterSportService()" disabled>Tạo đơn hàng</button>
            </div>
        </div>

        <div id="grid_data" class="wrap_bg wrap_bg_no-padding mb20">
            <div class="col-xl-12 text-center" style="margin-top:200px">
            </div>
        </div>
    </div>
</section>

@section scripts {
    <script type="text/javascript" src="~/modules/water_sport.js"></script>
    <script type="text/javascript" src="~/modules/order_detail_watersport.js"></script>
    <script type="text/javascript" src="~/modules/order_detail_common.js"></script>
    <script type="text/javascript" src="~/modules/order_detail_html.js"></script>
}